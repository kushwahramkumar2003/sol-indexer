KAFKA_CLIENT_ID="" # kafka client id
KAFKA_BROKERS="" # kafka brokers
KAFKA_CONSUMER_GROUP_ID="" # kafka consumer group id
KAFKA_INPUT_TOPIC="webhook-events" # kafka input topic
KAFKA_OUTPUT_TOPIC="processed-events" # kafka output topic
KAFKA_DLQ_TOPIC="sol-indexer-dlq" # kafka dead letter queue topic
KAFKA_COMMIT_INTERVAL=1000 # in milliseconds
KAFKA_MESSAGE_TIMEOUT=30000 # in milliseconds
KAFKA_USERNAME=""
KAFKA_PASSWORD=""
KAFKA_SASL_MECHANISM=plain
CA_CIRT_PATH="" # path to the kafka ca cert
PROCESSING_WORKER_COUNT=1
PROCESSING_BATCH_SIZE=1
PROCESSING_MAX_RETRIES=3
PROCESSING_RETRY_BACKOFF_MS=1000
CONFIG_CACHE_TTL_MS=60000 # in milliseconds
DB_POOL_SIZE=10
METRICS_PORT=3001
LOG_LEVEL="info"